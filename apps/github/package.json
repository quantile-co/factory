{
  "name": "@quantile-co/factory-github-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit -p ../../tsconfig.json && vitest run migration.test.ts --maxWorkers=1 && node --import tsx --test migration.process.test.ts",
