#!/usr/bin/env bash
# shellcheck shell=bash

# Fail loading rather than fall back to an ambient Devenv CLI.
strict_env

# Load optional, untracked local settings and credentials.
source_env_if_exists .envrc.local

# Select the Devenv CLI revision from the module pin in flake.nix.
# devenv.yaml follows this input, so the CLI and modules share a revision.
watch_file flake.nix flake.lock
DEVENV_INPUT_URL=$(nix eval --raw --file flake.nix inputs.devenv.url)
[[ $DEVENV_INPUT_URL =~ ^github:cachix/devenv/[a-f0-9]{40}\?dir=src/modules$ ]] || {
    log_error 'Expected a full-revision Devenv module input in flake.nix'
    return 1
}

# Build the matching Devenv CLI. The ignored link prevents garbage collection.
mkdir -p .devenv
# Build the pinned CLI without applying its flake-level Nix settings.
DEVENV_CLI_PACKAGE=$(nix build --impure \
    --out-link .devenv/cli --print-out-paths \
    --expr "let flake = builtins.getFlake \"${DEVENV_INPUT_URL%\?dir=src/modules}\"; in (builtins.getAttr builtins.currentSystem flake.packages).default")
export DEVENV_BIN="$DEVENV_CLI_PACKAGE/bin/devenv"

# Load direnv integration from the selected Devenv CLI, not the host CLI.
DEVENV_DIRENVRC=$("$DEVENV_BIN" direnvrc)
eval "$DEVENV_DIRENVRC"

# This integration exits successfully on build failure; fail closed, then
# restore direnv's EXIT trap after a successful load.
DEVENV_DIRENV_EXIT_TRAP=$(trap -p EXIT)
trap 'exit 1' EXIT
use devenv
eval "$DEVENV_DIRENV_EXIT_TRAP"

# Keep the pinned CLI available in the shell; discard bootstrap values.
PATH_add "$DEVENV_CLI_PACKAGE/bin"
unset DEVENV_INPUT_URL DEVENV_CLI_PACKAGE DEVENV_DIRENVRC DEVENV_DIRENV_EXIT_TRAP
