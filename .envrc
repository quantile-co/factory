#!/usr/bin/env bash
# shellcheck shell=bash

strict_env
source_env_if_exists .envrc.local

export NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG}
}extra-experimental-features = nix-command flakes
extra-substituters = https://quantile-co.cachix.org https://cache.numtide.com https://cachix.cachix.org https://pre-commit-hooks.cachix.org
extra-trusted-public-keys = quantile-co.cachix.org-1:OM+kQzUqP3Ija8QQMUxvQNs97u6PB5/s83ZJe7c9WIQ= niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g= cachix.cachix.org-1:eWNHQldwUO7G2VkjpnjDbWwy4KQ/HNxht7H4SSoMckM= pre-commit-hooks.cachix.org-1:Pkk3Panw5AW24TOv6kz3PvLhlH8puAsJTBbOPmBo7Rc="

use flake
node scripts/files.mjs materialize "$FACTORY_FILES_MANIFEST"

PI_MEMORY_DIR="$(git rev-parse --show-toplevel)/.pi/memory"
export PI_MEMORY_DIR PI_MEMORY_EXIT_SUMMARY=0
