#!/usr/bin/env bash
# shellcheck shell=bash

strict_env
source_env_if_exists .envrc.local

export NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG}
}extra-experimental-features = nix-command flakes"

# Set up cache reads before `use flake`: Nix needs the shell dependencies
# before it can run a shell hook.
# Untrusted daemon clients must use administrator-configured caches and keys.
nix_store_info=$(nix store info --json) || return
if [[ $nix_store_info =~ \"trusted\"[[:space:]]*:[[:space:]]*true ]]; then
    cache_public_key=''
    if [[ -n $cache_public_key && ${NIX_CACHE_SUBSTITUTER:-} =~ ^https?://[^[:space:]]+$ ]]; then
        export NIX_CONFIG="${NIX_CONFIG}
extra-substituters = ${NIX_CACHE_SUBSTITUTER}
extra-trusted-public-keys = ${cache_public_key}"
    fi
    unset cache_public_key
    export NIX_CONFIG="${NIX_CONFIG}
extra-substituters = https://quantile-co.cachix.org https://cache.numtide.com https://cachix.cachix.org https://pre-commit-hooks.cachix.org
extra-trusted-public-keys = quantile-co.cachix.org-1:OM+kQzUqP3Ija8QQMUxvQNs97u6PB5/s83ZJe7c9WIQ= niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g= cachix.cachix.org-1:eWNHQldwUO7G2VkjpnjDbWwy4KQ/HNxht7H4SSoMckM= pre-commit-hooks.cachix.org-1:Pkk3Panw5AW24TOv6kz3PvLhlH8puAsJTBbOPmBo7Rc="
fi
unset nix_store_info

use flake
