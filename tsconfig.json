{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["**/dist/**", "**/node_modules/**"],
  "include": [
    ".github/actions/**/*.ts",
    "*.test.ts",
    "nix/**/*.test.ts",
    "tf/**/*.test.ts",
    "apps/**/*.ts",
    "packages/**/*.ts"
  ]
}
