{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc}"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{ts,tsx,mts,cts}"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "error"
          },
          "style": {
            "noEnum": "error",
            "noInferrableTypes": "error",
            "noNamespace": "error",
            "noParameterProperties": "error",
            "useAsConstAssertion": "error",
            "useReadonlyClassProperties": "error",
            "useReduceTypeParameter": "error"
          },
          "suspicious": {
            "noExplicitAny": "error",
            "noExtraNonNullAssertion": "error",
            "noNonNullAssertedOptionalChain": "error"
          },
          "nursery": {
            "noMisleadingReturnType": "error",
            "noUselessTypeAssertion": "error",
            "useExhaustiveSwitchCases": {
              "level": "error",
              "options": {
                "requireExplicitCase": true
              }
            },
            "useStrictBooleanExpressions": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.{ts,tsx,mts,cts}",
        "!**/*.{test,spec}.{ts,tsx,mts,cts}"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeReturn": "error"
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "path": "./.biome/no-literal-type-assertions.grit",
      "includes": [
        "**/*.{ts,tsx,mts,cts}",
        "!**/*.{test,spec}.{ts,tsx,mts,cts}"
      ]
    }
  ]
}
