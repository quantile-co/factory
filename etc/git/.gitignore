# Never expose legacy local state from existing worktrees.
.devenv/
.devenv.flake.nix
.direnv/
node_modules/
dist/
.turbo/
/.husky/_/
.envrc.local
gha-creds-*.json
.pi/npm/
.pi/git/
.agents/skills/
result
result-*
# Keep local Terraform data, backend overrides, plans, and diagnostics out of Git.
.terraform/
.terraform.tfstate.lock.info
backend_override.tf
*.tfstate
*.tfstate.*
*.tfplan
plan.json
crash.log
