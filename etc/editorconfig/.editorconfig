root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt also applies this style to extensionless scripts with shell shebangs.
[[shell]]
indent_style = space
indent_size = 4
simplify = true
switch_case_indent = true

[*.{sh,bash,bats}]
indent_style = space
indent_size = 4
simplify = true
switch_case_indent = true

[*.{c,h,cpp,hpp,cc,hh,cxx,hxx}]
indent_style = space
indent_size = 4

[*.{yaml,yml,nix}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[*.tf]
indent_style = space
indent_size = 2
