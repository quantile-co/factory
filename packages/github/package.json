{
  "name": "@quantile-co/factory-github",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Private saved-plan transport for repository-owned deployment commands.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantile-co/factory.git",
    "directory": "packages/github"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=4"
  }
}
