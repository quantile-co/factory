{
  "name": "@quantile-co/factory-otel",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Collector endpoint configuration and OTLP metadata export.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantile-co/factory.git",
    "directory": "packages/otel"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./src/config.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=4"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2"
  }
}
