{
  "name": "@quantile-co/factory-otel",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Opt-in OpenTelemetry agents and privacy-scoped ClickHouse Observability tracing.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantile-co/factory.git",
    "directory": "packages/otel"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./collector": {
        "types": "./dist/collector.d.ts",
        "default": "./dist/collector.js"
      },
      "./otlp": {
        "types": "./dist/otlp.d.ts",
        "default": "./dist/otlp.js"
      },
      "./tracing": {
        "types": "./dist/tracing.d.ts",
        "default": "./dist/tracing.js"
      },
      "./cli": "./dist/cli.js"
    }
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./src/config.ts"
    },
    "./collector": {
      "types": "./dist/collector.d.ts",
      "default": "./src/collector.ts"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "default": "./src/otlp.ts"
    },
    "./tracing": {
      "types": "./dist/tracing.d.ts",
      "default": "./src/tracing.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "factory-otel": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=4"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.1",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace": "2.12.1"
  }
}
