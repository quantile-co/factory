#!/usr/bin/env bash
set -euo pipefail
[[ ${AMP_ORB:-} == 1 ]] || {
    echo 'This hook is only for an Amp orb.' >&2
    exit 1
}
unset CLICKSTACK_OTLP_ENDPOINT CLICKSTACK_API_KEY OTEL_DOCKER_STATS
cd -- "$(dirname -- "$0")/.."
# Expand runtime paths inside the pinned shell, not the outer hook.
# shellcheck disable=SC2016
nix develop --command bash -euo pipefail -c '
  pnpm install --frozen-lockfile
  pnpm run build
  pnpm amp setup
  install -D -m 0644 packages/amp/dist/plugin.js "${XDG_CONFIG_HOME:-$HOME/.config}/amp/plugins/factory-orb-awake.js"
  install -D -m 0644 packages/amp/dist/telemetry.js "${XDG_CONFIG_HOME:-$HOME/.config}/amp/plugins/factory-observability.js"
'
