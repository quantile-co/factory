#!/usr/bin/env bash
set -euo pipefail
set +x
[[ ${AMP_ORB:-} == 1 ]] || {
    echo 'This hook is only for an Amp orb.' >&2
    exit 1
}
cd -- "$(dirname -- "$0")/.."
umask 077
# Never expose ingestion credentials to logging children, Nix evaluation or shell snapshots.
export -n CLICKSTACK_OTLP_ENDPOINT CLICKSTACK_API_KEY OTEL_DOCKER_STATS
# Retain early output; close the writer and drain tee when the hook exits.
amp_logs="$HOME/.local/share/factory-amp/logs"
mkdir -p "$amp_logs"
exec > >(tee -a "$amp_logs/resume.log") 2>&1
amp_log_pid=$!
trap 'exec 1>&- 2>&-; wait "$amp_log_pid"' EXIT
unset amp_logs
source .agents/nix-env
shell=$(nix print-dev-env)
eval "$shell"
unset shell
export CLICKSTACK_OTLP_ENDPOINT CLICKSTACK_API_KEY OTEL_DOCKER_STATS
pnpm amp resume --repo quantile-co/factory --directory "$PWD"
