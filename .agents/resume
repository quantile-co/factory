#!/usr/bin/env bash
set -euo pipefail
set +x
[[ ${AMP_ORB:-} == 1 ]] || {
    echo 'This hook is only for an Amp orb.' >&2
    exit 1
}
cd -- "$(dirname -- "$0")/.."
umask 077
# Never expose ingestion credentials to Nix evaluation or shell snapshots.
export -n CLICKSTACK_OTLP_ENDPOINT CLICKSTACK_API_KEY OTEL_DOCKER_STATS
source .agents/nix-env
shell=$(nix print-dev-env)
eval "$shell"
unset shell
export CLICKSTACK_OTLP_ENDPOINT CLICKSTACK_API_KEY OTEL_DOCKER_STATS
pnpm amp resume --repo quantile-co/factory --directory "$PWD"
