{
  "name": "@quantile-co/factory",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "check": "pnpm run build && turbo run check",
    "fix": "pnpm --filter @quantile-co/factory-repo-cli fix",
    "test": "pnpm run check && turbo run test",
    "build": "turbo run build",
    "prepare": "husky",
    "skills:sync": "skills experimental_sync --agent pi --copy --yes",
    "npm:pack": "pnpm test && pnpm --filter @quantile-co/factory-github pack --out dist/npm/factory-github.tgz && pnpm --filter @quantile-co/factory-pi pack --out dist/npm/factory-pi.tgz",
    "npm:stage": "npm stage publish dist/npm/factory-github.tgz --access public && npm stage publish dist/npm/factory-pi.tgz --access public",
    "amp": "tsx apps/amp/cli.ts",
    "amp:pack": "pnpm test && pnpm --filter @quantile-co/factory-amp pack --out dist/npm/factory-amp.tgz",
    "amp:stage": "npm stage publish dist/npm/factory-amp.tgz --access public",
    "pi:pack": "pnpm test && pnpm --filter @quantile-co/factory-pi pack --out dist/npm/factory-pi.tgz",
    "pi:stage": "npm stage publish dist/npm/factory-pi.tgz --access public",
    "otel:pack": "pnpm test && pnpm --filter @quantile-co/factory-otel pack --out dist/npm/factory-otel.tgz",
    "otel:stage": "npm stage publish dist/npm/factory-otel.tgz --access public",
    "namespace:nixcache:proxy": "tsx apps/namespace/cli.ts nixcache proxy",
    "namespace:nixcache:publish": "tsx apps/namespace/cli.ts nixcache publish",
    "namespace:nixcache:pack": "pnpm test && pnpm --filter @quantile-co/factory-namespace pack --out dist/npm/factory-namespace.tgz",
    "namespace:nixcache:stage": "npm stage publish dist/npm/factory-namespace.tgz --access public",
    "github:build": "tsx apps/github/cli.ts build",
    "github:test": "tsx apps/github/cli.ts test",
    "github:plan": "tsx apps/github/cli.ts plan",
    "github:apply": "tsx apps/github/cli.ts apply"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@langfuse/tracing": "6.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@quantile-co/factory-pi": "workspace:*",
    "@types/node": "26.6.5",
    "@vectorize-io/hindsight-coding-agents": "0.8.7",
    "husky": "9.1.7",
    "rolldown-plugin-dts": "0.28.8",
    "skills": "1.7.4",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.4"
  }
}
